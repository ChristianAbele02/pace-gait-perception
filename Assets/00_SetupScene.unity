  m_EditorHideFlags: 0
  m_Script: {fileID: 708705254, guid: f5f67c52d1564df4a8936ccd202a3bd8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0.19607843, g: 0.19607843, b: 0.19607843, a: 1}
  m_RaycastTarget: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
    m_TypeName: UnityEngine.UI.MaskableGraphic+CullStateChangedEvent, UnityEngine.UI,
      Version=1.0.0.0, Culture=neutral, PublicKeyToken=null
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 34
    m_FontStyle: 1
    m_BestFit: 1
    m_MinSize: 14
    m_MaxSize: 34
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: 'Welcome, and thank you for taking part!


    You will move through a virtual landscape,

    walking on the treadmill or standing still,

    as the experimenter tells you.


    Every now and then a small striped patch

    will flash briefly ahead of you.

    Each patch is tilted slightly LEFT or RIGHT.


    Your task is to report the tilt direction.

    Press the LEFT button for a left tilt,

    and the RIGHT button for a right tilt.


    Some patches are easy, others harder -

    that is completely normal.

    Answer as accurately as you can,

    and make your best guess when unsure.


    Please keep looking straight ahead,

    and move at a natural, steady pace.


    There is a short rest at the start and end -

    please relax and stand calmly during these.


    The experimenter will begin when you are ready.'
