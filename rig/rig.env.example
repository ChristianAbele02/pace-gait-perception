# Settings for the rig scripts in this folder.
#
# Copy this file to rig/rig.env and fill in your installation. rig.env is git-ignored,
# so host names, user names and paths never end up in the repository.
#
# Plain KEY=value lines only: the bash scripts source this file, and deploy.ps1,
# start.ps1 and ill.py parse it. Keep comments on their own lines.

# --- Head node (Linux; runs the head-node build) ---------------------------------
# SSH host of the head node as seen from your workstation. An alias from ~/.ssh/config
# is easiest; put any jump host (ProxyJump) there too.
ILL_HEAD_NODE=head-node
# Absolute path of this repository's checkout on the head node.
ILL_REMOTE_PROJECT=/path/to/PACE
# Unity 2017.4.25f1 editor on the head node, used by build.sh.
ILL_UNITY_EDITOR=/opt/unity-2017.4.25f1/Editor/Unity
# Python virtualenv on the head node that has PyNaCl and msgpack (for ill.py).
ILL_PYTHON_VENV=~/ill-venv
# Resolution of the head node's operator monitor.
ILL_HEAD_SCREEN=1680x1050

# --- Render nodes (Windows; one per CAVE wall) -----------------------------------
# Space-separated host:user pairs, in wall order left, front, right.
ILL_RENDER_NODES="render-node-1:renderuser1 render-node-2:renderuser2 render-node-3:renderuser3"
# SSH key the head node uses to log in to the render nodes.
ILL_RENDER_KEY=~/.ssh/pace_render_nodes
# Build folder on each render node, relative to the render user's home folder.
ILL_RENDER_DEST=Projects/PACE
# TCP port of the start/stop listener on the render nodes.
ILL_CONTROL_PORT=9999
# File holding the Ed25519 signing seed for that listener (64 hex characters, chmod 600).
# Alternatively export ILL_SIGNING_KEY with the seed itself.
ILL_SIGNING_KEY_FILE=~/.pace/signing_key
